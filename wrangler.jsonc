{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app56",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3d83d055-c261-442b-b1ba-ae7a8a380dd0","database_name": "web-app56" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "282455693b5746c7bab4a16d1d526077" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
